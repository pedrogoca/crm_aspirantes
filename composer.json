{
  "name": "mwconsultores/crm-aspirantes",
  "type": "project",
  "description": "CRM de admisiones institucionales con Laravel 12 y MySQL",
  "require": {"php":"^8.2","laravel/framework":"^12.0","laravel/tinker":"^2.10"},
  "require-dev": {"fakerphp/faker":"^1.23","laravel/pint":"^1.22","nunomaduro/collision":"^8.6","phpunit/phpunit":"^11.5"},
  "autoload": {"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev": {"psr-4":{"Tests\\":"tests/"}},
  "scripts": {"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],"post-create-project-cmd":["@php artisan key:generate --ansi"]},
  "extra": {"laravel":{"dont-discover":[]}},
  "config": {"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true},
  "minimum-stability":"stable","prefer-stable":true
}